#!/usr/bin/env bash
# Maintainer tool: cut a release. Not shipped to users (dev/, not bin/). See --help.
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: dev/release [--bump] [--allow-dirty] [--dry-run] [version]

Cut a release: check, bump the version, regenerate CHANGELOG.md, commit, tag, push.

  version         X.Y.Z or vX.Y.Z
  --bump          take the version from `git-cliff --bumped-version`
  --allow-dirty   allow uncommitted changes (memory.md is always ignored)
  --dry-run       run every check, then print what would happen
                  (also DRY_RUN=1); changes nothing and never asks

Steps: dirty check, version and tag check, dev/scrub.sh + tests +
`claude plugin validate .` (warnings are printed, only a failure stops), write the version into SKILL.md
(metadata.version) and .claude-plugin/plugin.json, `git-cliff -o CHANGELOG.md`,
then confirmation 1 (default No) to commit + tag, confirmation 2 (default No)
to push. There is no -y flag: commits and pushes need the maintainer's approval.
EOF
}

die() { echo "release: $*" >&2; exit 1; }

case ${DRY_RUN:-0} in 0|1) ;; *) die "DRY_RUN must be empty, 0 or 1, not: $DRY_RUN" ;; esac
dry=${DRY_RUN:-0}; bump=0; dirty_ok=0; arg=""
while [ $# -gt 0 ]; do
  case $1 in
    -h|--help) usage; exit 0 ;;
    --bump) bump=1 ;;
    --allow-dirty) dirty_ok=1 ;;
    --dry-run) dry=1 ;;
    -*) usage >&2; die "unknown option: $1" ;;
    *) [ -z "$arg" ] || die "only one version allowed"; arg=$1 ;;
  esac
  shift
done
[ "$bump" = 1 ] && [ -n "$arg" ] && die "give a version or --bump, not both"
[ "$bump" = 1 ] || [ -n "$arg" ] || { usage >&2; die "give a version or --bump"; }

python3 -c 'import sys; sys.exit(sys.version_info < (3, 10))' || die "needs python3 3.10 or newer"
cd "$(dirname "$0")/.."
git rev-parse --git-dir >/dev/null 2>&1 || die "not a git repository"

semver='^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$'  # no pre-releases: tests/test_plugin.py expects the same
if [ -n "$arg" ]; then
  version=${arg#v}
  [[ $version =~ $semver ]] || die "not a semantic version: $arg (use X.Y.Z)"
fi

if [ "$dry" = 0 ]; then
  command -v git-cliff >/dev/null || die "git-cliff is not installed"
  command -v claude >/dev/null || die "the claude CLI is not installed (needed for 'claude plugin validate')"
fi

branch=$(git symbolic-ref --short -q HEAD) || die "detached HEAD, check out a branch first"
files=(skills/pmo-docs/SKILL.md .claude-plugin/plugin.json)
commit_paths=(CHANGELOG.md "${files[@]}")
memory_staged=0
git ls-files --error-unmatch memory.md >/dev/null 2>&1 && memory_staged=1

# 1. uncommitted changes (memory.md is local-only and never committed, so it is ignored)
dirty=$(git status --porcelain -- . ':!memory.md')
if [ -n "$dirty" ]; then
  if [ "$dirty_ok" = 0 ]; then
    echo "$dirty" >&2
    die "uncommitted changes above (memory.md ignored); commit them or pass --allow-dirty"
  fi
  # the release commit is path-limited, so these two files must hold nothing else
  bad=$(git status --porcelain -- "${files[@]}")
  [ -z "$bad" ] || { echo "$bad" >&2; die "the version files have uncommitted changes, even --allow-dirty refuses"; }
  echo "warning: continuing with uncommitted changes (they stay out of the release commit):" >&2
  echo "$dirty" >&2
fi

# 2. version and tag (done before the slow checks so a bad argument fails fast)
if [ "$bump" = 1 ]; then
  command -v git-cliff >/dev/null || die "git-cliff is not installed"
  version=$(git-cliff --bumped-version) || die "git-cliff could not suggest a version"
  version=${version#v}
  [[ $version =~ $semver ]] || die "git-cliff suggested an odd version: $version"
fi
tag="v$version"
git rev-parse -q --verify "refs/tags/$tag" >/dev/null && die "tag $tag already exists"

# 3. checks (RELEASE_SKIP_CHECKS only counts in a dry run; the tests use it)
if [ "$dry" = 1 ] && [ "${RELEASE_SKIP_CHECKS:-0}" = 1 ]; then
  echo "dry run: checks skipped"
else
  echo "== dev/scrub.sh"; bash dev/scrub.sh || die "scrub failed"
  echo "== tests"; python3 -m unittest discover tests || die "tests failed"
  if command -v claude >/dev/null; then
    echo "== claude plugin validate"; claude plugin validate . || die "plugin validation failed"
  else
    die "the claude CLI is not installed (needed for 'claude plugin validate')"
  fi
fi

# 4. write the version into SKILL.md and plugin.json (text edit, formatting kept)
set_version() { # $1 = write | check
python3 - "$1" "$version" <<'PY'
import re, sys
mode, version = sys.argv[1:]

def fail(msg):
    sys.exit(f"release: {msg}")

def skill(text):
    m = re.match(r"---\n(.*?\n)---\n", text, re.S)
    if not m:
        fail("SKILL.md has no front matter")
    fm = m.group(1).split("\n")
    try:
        i = fm.index("metadata:")
    except ValueError:
        fail("SKILL.md front matter has no 'metadata:' line")
    j = i + 1
    while j < len(fm) and fm[j].startswith((" ", "\t")):
        if re.match(r"\s+version\s*:", fm[j]):
            fm[j] = re.sub(r"(version\s*:).*", rf'\1 "{version}"', fm[j])
            break
        j += 1
    else:
        fm.insert(i + 1, f'  version: "{version}"')
    return "---\n" + "\n".join(fm) + text[m.end(1):]

def plugin(text):
    new, n = re.subn(r'^(\s*"version"\s*:\s*)"[^"]*"', rf'\1"{version}"', text, flags=re.M)
    if n != 1:
        fail(f'plugin.json: expected one "version" key, found {n}')
    return new

for path, fn in (("skills/pmo-docs/SKILL.md", skill), (".claude-plugin/plugin.json", plugin)):
    with open(path, encoding="utf-8", newline="") as f:
        old = f.read()
    new = fn(old)
    if mode == "write" and new != old:
        with open(path, "w", encoding="utf-8", newline="") as f:
            f.write(new)
PY
}

if [ "$dry" = 1 ]; then
  set_version check
  cat <<EOF
== dry run: nothing changed. Version $version (tag $tag) on branch $branch.
Would: set version in ${files[*]}
       git-cliff -o CHANGELOG.md --tag $tag, and print the release notes
       ask to commit "chore(release): $tag" of ${commit_paths[*]} and tag it (default No)
       ask to run: git push --atomic origin HEAD $tag (default No)
EOF
  exit 0
fi

changelog_tracked=0
git ls-files --error-unmatch CHANGELOG.md >/dev/null 2>&1 && changelog_tracked=1
done=0
undo() {
  [ "$done" = 1 ] && return
  echo "To undo:" >&2
  echo "  git checkout -- ${files[*]}" >&2
  if [ "$changelog_tracked" = 1 ]; then echo "  git checkout -- CHANGELOG.md" >&2
  else echo "  git rm --cached -q CHANGELOG.md && rm -f CHANGELOG.md   (skip the git rm if the add did not happen)" >&2; fi
}
trap undo EXIT

set_version write
git-cliff -o CHANGELOG.md --tag "$tag"
! grep -q 'github.com///' CHANGELOG.md || die "changelog links have no owner/repo (set an upstream branch)"
echo "== release notes for $tag"
git-cliff --unreleased --tag "$tag" --strip header

confirm() { # default No; no terminal or EOF counts as No
  local ans
  printf '%s [y/N] ' "$1" >&2
  read -r ans 2>/dev/null </dev/tty || { echo >&2; return 1; }
  [[ $ans == [yY] || $ans == [yY][eE][sS] ]]
}

echo
echo "Release $tag on branch $branch"
echo "Files in the commit: ${commit_paths[*]}"
confirm "Commit 'chore(release): $tag' and tag $tag?" || { echo "Aborted." >&2; exit 1; }

git add -- CHANGELOG.md   # the only add: CHANGELOG.md is new at v0.1.0, and a path-limited commit needs it tracked
git commit -m "chore(release): $tag" -- "${commit_paths[@]}"
done=1  # the commit exists: the trap's undo would be wrong from here on
git tag -a "$tag" -m "$tag" || die "the release commit exists but tagging failed; run: git tag -a $tag -m $tag (or undo: git reset --soft HEAD~1)"
echo "Committed and tagged $tag."
{ [ "$memory_staged" = 0 ] || git ls-files --error-unmatch memory.md >/dev/null 2>&1; } || echo "Note: the path-limited commit unstaged memory.md; run 'git add memory.md' to see it again."

if confirm "Push HEAD and $tag to origin?"; then
  git push --atomic origin HEAD "$tag" || die "push failed; commit and tag are local only. Retry: git push --atomic origin HEAD $tag"
else
  echo "Not pushed. Later: git push --atomic origin HEAD $tag" >&2
  echo "To undo the release: git tag -d $tag && git reset --soft HEAD~1" >&2
fi
