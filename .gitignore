# local-only: names that must never enter the repo (used by dev/scrub.sh)
.scrub-names

# python
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/

# editors and OS
.DS_Store
.idea/
.vscode/

# agent session state and local tool caches
.claude/settings.local.json
graphify-out/
tmp/
.trail/
/graft/
claude-tests/

# secrets
.env
.env.*
*.pem
*.key

# a project's private working data must never live in this repo
pmo/inbox/

# eval run output
evals/results/
